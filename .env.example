# Copy to .env (cp .env.example .env) and edit. .env is gitignored.
#
# How to switch models on the default stock Vulkan stack:
#   1. Comment out the active MODEL PACKAGE block below (all its lines).
#   2. Uncomment ONE other MODEL PACKAGE block in full (model, template,
#      alias, ctx, parallel, COMPOSE_FILE).
#   3. docker compose down && docker compose up -d
#
# COMPOSE_FILE merges docker-compose.yml with the per-model package under
# compose/models/ (MTP, sampling, KV type). Leave COMPOSE_FILE unset only
# if you want the bare server flags from docker-compose.yml alone.

# --- shared host paths / GPU -------------------------------------------------

# MODELS_DIR: host folder holding GGUF files (mounted read-only at /models).
# Absolute path recommended (e.g. /home/you/models/gguf).
MODELS_DIR=./models

# Group IDs so the container can reach /dev/dri:
#   getent group render | cut -d: -f3   -> RENDER_GID
#   getent group video  | cut -d: -f3   -> VIDEO_GID
RENDER_GID=990
VIDEO_GID=44

# LLM_PORT / LLM_NGL are shared by every stock-Vulkan model package.
LLM_PORT=8080
LLM_NGL=99

# Hugging Face token (optional). Speeds up / unlocks gated downloads:
#   HF_TOKEN=... hf download <repo> <file> --local-dir "$MODELS_DIR/<dir>"
HF_TOKEN=

# GTT (not VRAM) is forced in docker-compose.yml via GGML_VK_PREFER_HOST_MEMORY=1.
# Presence check: any value enables it. To turn it off, remove that env line
# from the compose file (setting 0 does not disable it).


# =============================================================================
# MODEL PACKAGES (default stack: docker-compose.yml + compose/models/*.yml)
# Uncomment exactly ONE package. Leave LLM_MODEL blank only until you pick one
# (compose fails fast if it stays empty).
# =============================================================================

# --- package A: Qwen3.6-27B heretic-v2 Q8_0 (Native MTP preserved) -----------
# Dense 27B. Native max context 262144. MTP ON in the model package.
# Download:
#   hf download llmfan46/Qwen3.6-27B-uncensored-heretic-v2-Native-MTP-Preserved-GGUF \
#     Qwen3.6-27B-uncensored-heretic-v2-Native-MTP-Preserved-Q8_0.gguf \
#     --local-dir "$MODELS_DIR/Qwen3.6-27B-heretic-v2"
# Five slots at 131072 (total 655360). Raise per-slot toward 262144 only if
# GTT headroom allows (weights ~28 GB Q8).
#COMPOSE_FILE=docker-compose.yml:compose/models/qwen3.6-27b-heretic.yml
#LLM_MODEL=Qwen3.6-27B-heretic-v2/Qwen3.6-27B-uncensored-heretic-v2-Native-MTP-Preserved-Q8_0.gguf
#LLM_CHAT_TEMPLATE=Qwen3.6-27B-heretic-v2/chat_template.jinja
#LLM_ALIAS=qwen3.6-27b-heretic-v2-q8
#LLM_CTX_PER_SLOT=131072
#LLM_PARALLEL=5
#LLM_CTX_TOTAL=655360

# --- package B: Qwen3.6-35B-A3B heretic Q8_0 ---------------------------------
# MoE 35B total / 3B active. Native max context 262144. No MTP in this GGUF
# (non-MTP-preserved heretic quant).
# Download:
#   hf download llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-GGUF \
#     Qwen3.6-35B-A3B-uncensored-heretic-Q8_0.gguf \
#     --local-dir "$MODELS_DIR/Qwen3.6-35B-A3B-heretic"
#COMPOSE_FILE=docker-compose.yml:compose/models/qwen3.6-35b-heretic.yml
#LLM_MODEL=Qwen3.6-35B-A3B-heretic/Qwen3.6-35B-A3B-uncensored-heretic-Q8_0.gguf
#LLM_CHAT_TEMPLATE=Qwen3.6-35B-A3B-heretic/chat_template.jinja
#LLM_ALIAS=qwen3.6-35b-a3b-heretic-q8
#LLM_CTX_PER_SLOT=131072
#LLM_PARALLEL=5
#LLM_CTX_TOTAL=655360

# --- package C: Laguna S 2.1 IQ4_XS (vcruz305 imatrix) -----------------------
# MoE 118B total / 8B active. GGUF context 262144 (YaRN). No MTP.
# Local path on this box uses the official imatrix IQ4_XS split.
# Download (if needed):
#   HF_TOKEN="$HF_TOKEN" hf download vcruz305/Laguna-S-2.1-GGUF \
#     Laguna-S-2.1-IQ4_XS-00001-of-00002.gguf \
#     Laguna-S-2.1-IQ4_XS-00002-of-00002.gguf \
#     --local-dir "$MODELS_DIR/laguna-s-2.1"
# Package sets flash-attn, q8 KV, temp 0.7 / top-p 0.95 / top-k 20.
#COMPOSE_FILE=docker-compose.yml:compose/models/laguna-s-2.1.yml
#LLM_MODEL=laguna-s-2.1/Laguna-S-2.1-IQ4_XS-00001-of-00002.gguf
#LLM_CHAT_TEMPLATE=laguna-s-2.1/chat_template.jinja
#LLM_ALIAS=laguna-s21-iq4xs
#LLM_CTX_PER_SLOT=131072
#LLM_PARALLEL=5
#LLM_CTX_TOTAL=655360

# --- package D: Gemma 4 26B-A4B It Abliterated Q5_K_M (SevenOfNine) ----------
# MoE 26B total / ~4B active. Native max context 262144 (medium Gemma 4).
# No MTP. Use HF_TOKEN for a faster authenticated download:
#   HF_TOKEN="$HF_TOKEN" hf download \
#     SevenOfNine/Gemma-4-26B-A4B-It-Abliterated-GGUF \
#     Gemma-4-26B-A4B-It-Abliterated-Q5_K_M.gguf \
#     --local-dir "$MODELS_DIR/gemma-4-26b-a4b-abliterated"
# Keep the refreshed chat_template.jinja beside the GGUF.
#COMPOSE_FILE=docker-compose.yml:compose/models/gemma-4-26b-a4b.yml
#LLM_MODEL=gemma-4-26b-a4b-abliterated/Gemma-4-26B-A4B-It-Abliterated-Q5_K_M.gguf
#LLM_CHAT_TEMPLATE=gemma-4-26b-a4b-abliterated/chat_template.jinja
#LLM_ALIAS=gemma-4-26b-a4b-abliterated-q5
#LLM_CTX_PER_SLOT=131072
#LLM_PARALLEL=5
#LLM_CTX_TOTAL=655360

# Required by docker-compose.yml. Leave blank until you uncomment a package
# above (or set them yourself). Compose fails at up/config if still empty.
LLM_MODEL=
LLM_CHAT_TEMPLATE=
LLM_ALIAS=llm

# Defaults used when a package does not override them (must stay consistent:
# LLM_CTX_TOTAL = LLM_CTX_PER_SLOT * LLM_PARALLEL).
LLM_CTX_PER_SLOT=131072
LLM_PARALLEL=5
LLM_CTX_TOTAL=655360


# =============================================================================
# OPTIONAL: ROCmFP4 + MTP stack (docker-compose.rocmfp4.yml)
# =============================================================================
# ONLY for plunderstruck's Qwen3.6 ROCmFP4 GGUFs (custom Q4_0_ROCMFP4 tensors).
# Stock server-vulkan cannot load them.
#
# First start is slow: builds charlie12345/rocmfp4-llama from source on
# ubuntu:26.04, downloads a TheRock ROCm 7.13 tarball (~multi-GB), compiles
# Vulkan + HIP for gfx1151. Expect tens of minutes on a cold Docker cache.
# Later starts reuse the image. Needs /dev/kfd + /dev/dri.
#
#   docker compose -f docker-compose.rocmfp4.yml up -d --build
#   docker compose -f docker-compose.rocmfp4.yml logs -f llm
#
# Do not run this stack at the same time as the default Vulkan stack (both
# bind port 8080).

# ROCMFP4_MODEL / ROCMFP4_CHAT_TEMPLATE: blank until you pick a ROCmFP4 GGUF.
# Examples (uncomment a pair):
#   ROCMFP4_MODEL=Qwen3.6-27b/Qwen3.6-27B-OBLITERATED-MTP-ROCmFP4-STRIX-embF16-imatrix-headQ6.gguf
#   ROCMFP4_CHAT_TEMPLATE=Qwen3.6-27b/chat_template.jinja
#   ROCMFP4_MODEL=Qwen3.6-35B-A3B-MTP-ROCmFP4/Qwen3.6-35B-A3B-MTP-ROCmFP4-STRIX-embF16-headQ6.gguf
#   ROCMFP4_CHAT_TEMPLATE=Qwen3.6-35B-A3B-MTP-ROCmFP4/chat_template.jinja
ROCMFP4_MODEL=
ROCMFP4_CHAT_TEMPLATE=
ROCMFP4_ALIAS=rocmfp4
ROCMFP4_PORT=8080

# Five fixed slots at the native 262144-token (256K) model maximum.
ROCMFP4_CTX_PER_SLOT=262144
ROCMFP4_PARALLEL=5
ROCMFP4_CTX_TOTAL=1310720

# Bound container memory. Target KV q8_0, speculative draft q4_0.
ROCMFP4_KV_TYPE=q8_0
ROCMFP4_DRAFT_KV_TYPE=q4_0
ROCMFP4_MEMORY_LIMIT=90g

# TheRock ROCm dist pin (gfx1151 in matrix from 7.13). Last 7.13 nightly.
ROCMFP4_THEROCK_VERSION=7.13.0a20260515
ROCMFP4_GFX=gfx1151


# =============================================================================
# OPTIONAL: Laguna ROCmFPX stack (docker-compose.laguna-rocmfpx.yml)
# =============================================================================
# Separate Ciru ROCmFPX Runtime V2 image for the Chadrock ROCmFP4 V4 GGUF only.
# First build also compiles from a pinned commit (slower than a pull).
#   docker compose -f docker-compose.laguna-rocmfpx.yml up -d --build

LAGUNA_ROCMFPX_MODEL=laguna-s-2.1/laguna-s-2.1-ROCmFP4-StrixKVSpine-v4.gguf
LAGUNA_ROCMFPX_ALIAS=laguna-s21-rocmfp4-strixkvspine-v4
LAGUNA_ROCMFPX_BIND=127.0.0.1
LAGUNA_ROCMFPX_PORT=8080
# 131072 is the model card's validated Runtime V2 profile.
LAGUNA_ROCMFPX_CTX=131072
